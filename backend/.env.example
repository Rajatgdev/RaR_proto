# Neon POOLED url (hostname contains -pooler) — used by the app.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?ssl=require
# Neon DIRECT url — used ONLY for migrations (python -m db.migrate).
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# Only used to parse plain-English -> parameter card.
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
